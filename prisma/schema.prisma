// Prisma Schema for Next.js 16 + Prisma 7
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================
// Enums
// ===========================================

enum Role {
  USER
  ADMIN
}

// ===========================================
// NextAuth.js Adapter Models
// ===========================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime? @map("email_verified")
  hashedPassword String?   @map("hashed_password")
  image          String?
  role           Role      @default(USER)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  accounts     Account[]
  sessions     Session[]
  items        Item[]
  polls        Poll[]
  votes        Vote[]
  pollComments PollComment[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===========================================
// Example Domain: Item (CRUD 예제)
// ===========================================

model Item {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("DRAFT") // DRAFT, PUBLISHED
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("items")
}

// ===========================================
// Grapoll: 여론조사 모델
// ===========================================

enum PollStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum PollType {
  OFFICIAL // 공식 여론조사
  SUGGESTED // 유저 제안
}

enum InteractionType {
  SINGLE_CHOICE // 단일 선택 (기본)
  BINARY // A vs B 양자택일
  EMOJI_REACTION // 이모지 반응
  SLIDER // 스펙트럼 슬라이더
  MULTIPLE_CHOICE // 복수 선택
  RANKING // 순위 매기기
}

enum SourceType {
  NEWS
  PAPER
  ARTICLE
  VIDEO
  OTHER
}

model Poll {
  id              String          @id @default(uuid())
  title           String
  description     String?         @db.Text
  imageUrl        String?         @map("image_url")
  category        String?
  aiContent       String?         @db.Text @map("ai_content")
  aiUpdatedAt     DateTime?       @map("ai_updated_at")
  type            PollType        @default(SUGGESTED)
  status          PollStatus      @default(DRAFT)
  interactionType InteractionType @default(SINGLE_CHOICE) @map("interaction_type")
  totalVotes      Int             @default(0) @map("total_votes")
  viewCount       Int             @default(0) @map("view_count")
  startsAt        DateTime?       @map("starts_at")
  endsAt          DateTime?       @map("ends_at")

  userId   String        @map("user_id")
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  options  PollOption[]
  votes    Vote[]
  sources  PollSource[]
  comments PollComment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, type])
  @@index([totalVotes])
  @@index([viewCount])
  @@map("polls")
}

model PollOption {
  id        String @id @default(uuid())
  text      String
  order     Int    @default(0)
  voteCount Int    @default(0) @map("vote_count")

  pollId String @map("poll_id")
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  Vote[]
  comments PollComment[]

  @@map("poll_options")
}

model Vote {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  pollId   String  @map("poll_id")
  optionId String? @map("option_id")

  // Interaction-specific fields
  sliderValue       Int?     @map("slider_value") // SLIDER: 0-100
  selectedOptionIds String[] @map("selected_option_ids") // MULTIPLE_CHOICE
  rankingData       Json?    @map("ranking_data") // RANKING: [optionId, ...]

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll   Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, pollId])
  @@map("votes")
}

model PollSource {
  id          String     @id @default(uuid())
  title       String
  url         String
  sourceType  SourceType @default(OTHER) @map("source_type")
  description String?

  pollId String @map("poll_id")
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("poll_sources")
}

model PollComment {
  id      String @id @default(uuid())
  content String @db.Text
  likes   Int    @default(0)

  userId   String      @map("user_id")
  pollId   String      @map("poll_id")
  parentId String?     @map("parent_id")
  optionId String?     @map("option_id")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll     Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  parent   PollComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  PollComment[] @relation("CommentReplies")
  option   PollOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pollId, createdAt])
  @@map("poll_comments")
}
